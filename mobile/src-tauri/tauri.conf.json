{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elysium Remote",
  "version": "0.1.0",
  "identifier": "com.hoya.elysium.remote",
  "build": {
    "beforeDevCommand": "npm run dev:mobile",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build:mobile",
    "frontendDist": "../../dist-mobile"
  },
  "app": {
    "windows": [
      {
        "title": "Elysium Remote",
        "width": 420,
        "height": 860,
        "backgroundColor": "#131417"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
